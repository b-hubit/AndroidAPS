<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- b-hubit fork (ios-live-activity): device builds only, see the AAPSClient Release settings.
	     Push is what lets Home Assistant update the glucose Live Activity while the app is frozen.
	     TestFlight and App Store builds use the production APNs environment. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
