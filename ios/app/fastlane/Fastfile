# b-hubit fork: signs the iOS client with Fastlane Match, like the Trio and iAPS builds of this
# organisation, instead of Xcode automatic signing.
#
# Automatic signing makes `xcodebuild archive` create an Apple Development profile first, and Apple
# refuses that for a team with no registered devices ("Your team has no devices from which to
# generate a provisioning profile"). Match uses the App Store distribution certificate already kept in
# Match-Secrets and an App Store profile, which needs no device.
#
# Run from ios/app (the directory holding this fastlane folder) by .github/workflows/ios-testflight.yml.

default_platform(:ios)

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

TEAMID = ENV.fetch("TEAMID")
OWNER = ENV.fetch("GITHUB_REPOSITORY_OWNER")
SCHEME = ENV.fetch("AAPS_SCHEME", "AAPSClient")
BUNDLE_SUFFIX = SCHEME == "AAPSClient2" ? "aapsclient2" : "aapsclient"
BUNDLE_ID = "org.nightscout.#{TEAMID}.#{BUNDLE_SUFFIX}"
PROJECT = File.expand_path("../AAPSClient.xcodeproj", __dir__)
OUTPUT = File.expand_path("../build", __dir__)

platform :ios do
  desc "Sign with Match, build and upload the iOS client to TestFlight"
  lane :testflight_client do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("FASTLANE_KEY_ID"),
      issuer_id: ENV.fetch("FASTLANE_ISSUER_ID"),
      key_content: ENV.fetch("FASTLANE_KEY")
    )

    # Not read-only: the first run has to create the App Store profile for this bundle id. The
    # distribution certificate is reused from Match-Secrets, never a new one.
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      team_id: TEAMID,
      app_identifier: [BUNDLE_ID],
      git_basic_authorization: Base64.strict_encode64("#{OWNER}:#{ENV.fetch('GH_PAT')}")
    )

    profile = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][BUNDLE_ID]

    # Manual App Store signing for the Release build of this one target. Set through the xcodeproj
    # gem directly: fastlane's update_code_signing_settings refuses this project ("Seems to be a very
    # old project file format") because the modern format has no TargetAttributes section. Only the
    # CI checkout is changed. The sdk-conditional identity is overwritten too, otherwise the
    # project's "Apple Development" for device builds would still win.
    require "xcodeproj"
    project = Xcodeproj::Project.open(PROJECT)
    target = project.targets.find { |t| t.name == SCHEME } or UI.user_error!("No target #{SCHEME}")
    release = target.build_configurations.find { |c| c.name == "Release" } or UI.user_error!("No Release")
    settings = release.build_settings
    settings["CODE_SIGN_STYLE"] = "Manual"
    settings["DEVELOPMENT_TEAM"] = TEAMID
    settings["CODE_SIGN_IDENTITY"] = "iPhone Distribution"
    settings["CODE_SIGN_IDENTITY[sdk=iphoneos*]"] = "iPhone Distribution"
    settings["PROVISIONING_PROFILE_SPECIFIER"] = profile
    settings["PRODUCT_BUNDLE_IDENTIFIER"] = BUNDLE_ID
    # Optional label for a test build (env AAPS_DISPLAY_NAME), shown under the icon and inside the app,
    # so a test build cannot be mistaken for the everyday one. Same bundle id: it replaces the installed
    # build, and TestFlight can switch back to an earlier one.
    display_name = ENV["AAPS_DISPLAY_NAME"].to_s
    settings["INFOPLIST_KEY_CFBundleDisplayName"] = display_name unless display_name.empty?

    # Use the Debug Kotlin/Native framework in this Release archive: the Release framework's
    # optimisation does not fit in a GitHub macOS runner's memory (see the workflow). Both the search
    # path and the Gradle task in the "Build shared framework" phase follow the configuration, so
    # both are switched.
    settings["KOTLIN_FRAMEWORK_KIND"] = "debug"
    release_line = "Release) KOTLIN_BUILD=Release ;;"
    target.shell_script_build_phases.each do |phase|
      next unless phase.shell_script.include?(release_line)
      phase.shell_script = phase.shell_script.sub(release_line, "Release) KOTLIN_BUILD=Debug ;;")
    end
    project.save
    UI.message("Signing #{SCHEME} (Release) with '#{profile}' for #{BUNDLE_ID}")

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } },
      output_directory: OUTPUT,
      output_name: "#{SCHEME}.ipa",
      buildlog_path: File.join(OUTPUT, "logs")
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      ipa: File.join(OUTPUT, "#{SCHEME}.ipa"),
      skip_waiting_for_build_processing: true,
      # "What to Test" in TestFlight, when the workflow passes one (env AAPS_TESTFLIGHT_NOTES).
      changelog: ENV["AAPS_TESTFLIGHT_NOTES"].to_s.empty? ? nil : ENV["AAPS_TESTFLIGHT_NOTES"]
    )
  end
end
